# Copia este archivo a .env (o define estas variables en tu proveedor de hosting)
# y NUNCA subas el .env real (con valores reales) al repositorio.

# Cadena de conexión a PostgreSQL (Supabase u otra instancia PostgreSQL)
DATABASE_URL=

# Secreto para firmar los tokens JWT — OBLIGATORIO, la app no arranca sin él.
# Genera un valor seguro, por ejemplo:
#   openssl rand -hex 32
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# Horas de vigencia del token JWT (opcional, por defecto 24)
JWT_EXPIRE_HOURS=24

# Orígenes permitidos por CORS, separados por coma (opcional)
CORS_ORIGINS=http://localhost,https://kukis-moda.netlify.app
