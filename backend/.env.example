# Obligatoria. Genera una distinta para cada entorno (dev/producción),
# por ejemplo con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

DATABASE_URL=sqlite:///kukis.db
FRONTEND_ORIGIN=http://localhost:5173

# Usuario y contraseña de la vendedora que se crean la primera vez que
# arranca la app (solo si todavía no existe ninguna cuenta). PASSWORD_INICIAL
# es obligatoria; NOMBRE_USUARIO_INICIAL es opcional (por default "vendedora").
# Después de ese primer arranque, cambia la contraseña desde el panel
# ("Cuenta") en vez de reusar estos valores.
NOMBRE_USUARIO_INICIAL=vendedora
PASSWORD_INICIAL=

PORT=5000

# Horas que un apartado "pendiente" puede quedar sin confirmarse antes de
# cancelarse automáticamente y liberar el stock.
APARTADO_HORAS_EXPIRACION=24

# Notificación por Telegram al crear un apartado (opcional: si se dejan
# vacías, simplemente no se envía ningún aviso).
# 1. Habla con @BotFather en Telegram, crea un bot con /newbot y copia el token.
# 2. Mándale un mensaje a tu bot y entra a
#    https://api.telegram.org/bot<TOKEN>/getUpdates para ver tu chat_id
#    (o usa @userinfobot para obtener tu chat_id directamente).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
